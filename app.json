{
  "expo": {
    "name": "protegey_example_react_native",
    "slug": "protegey_example_react_native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.protegey-example-react-native",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to scan your ID document and take a selfie during identity verification."
      }
    },
    "android": {
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.protegeyexamplereactnative"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
